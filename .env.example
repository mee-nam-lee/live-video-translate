# Authentication Mode: "adc" (default, uses Google Cloud ADC / Vertex AI Agent Platform) or "api_key"
AUTH_MODE=adc

# Google Cloud Project & Location (Used when AUTH_MODE=adc)
# Note: gemini-3.5-live-translate-preview requires location="global" on Vertex AI / Agent Platform
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Gemini API Key (Optional: Used when AUTH_MODE=api_key)
GEMINI_API_KEY=

# Model Configuration
LIVE_TRANSLATE_MODEL=gemini-3.5-live-translate-preview

# Session Management Configuration
# Inactivity timeout in seconds (Default: 600s = 10 minutes)
INACTIVITY_TIMEOUT_SECONDS=600

# Login Gate (fixed shared password; leave empty to disable login)
APP_LOGIN_PASSWORD=change-me
# Secret for signing login cookies (any long random string). Keep stable across deploys.
APP_SESSION_SECRET=
# Login session lifetime in hours
APP_SESSION_HOURS=12

# Video source: GCS bucket name (without gs://). Leave empty to serve from local videos/
VIDEOS_GCS_BUCKET=live-translate
# Optional object prefix inside the bucket (e.g. videos). Empty = bucket root
VIDEOS_GCS_PREFIX=

# Playout delay in seconds. The visible video is held back by this amount while audio
# from this far ahead is fed to the model, so subtitles/dubbing land in sync (0 = off)
PLAYOUT_DELAY_SECONDS=4.0
# Extra delay (seconds) for subtitles only. They naturally arrive ~0.5-0.8s before the dubbing,
# which gives reading time; keep 0 unless you want them aligned with the dubbing
SUBTITLE_EXTRA_DELAY_SECONDS=0
